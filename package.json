{
  "name": "nebula-docs",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "postinstall": "pnpm parse-domain-update",
    "start": "astro dev",
    "build": "pnpm parse-domain-update && astro build",
    "preview": "astro preview",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "astro check",
    "test": "uvu -r tsm src '\\.test\\.ts$'"
  },
  "dependencies": {
    "@astrojs/markdown-satteri": "^0.4.6",
    "@astrojs/mdx": "^8.1.2",
    "@astrojs/react": "^7.1.2",
    "@astrojs/starlight": "^0.42.8",
    "astro": "^7.4.7",
    "parse-domain": "^8.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@types/node": "^25.5.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.7",
    "fast-check": "^4.6.0",
    "prettier": "^3.8.1",
    "prettier-plugin-astro": "^1.1.2",
    "starlight-links-validator": "^0.27.0",
    "tsm": "^2.3.0",
    "typescript": "^5.9.3",
    "uvu": "^0.5.6"
  },
  "packageManager": "pnpm@9.7.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "type": "module"
}
