{
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": ["build"],
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    // If you add any more aliases here, be sure to also add them to prettier.config.mjs
    "paths": {
      "@docs/*": ["./src/content/docs/docs/*"],
      "@src/*": ["./src/*"],
      "@components/*": ["./src/components/*"]
    }
  }
}
